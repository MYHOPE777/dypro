# dypro 火山引擎接入参数模板
#
# 使用方式：
#   1. 从火山引擎控制台取得对应参数；
#   2. 复制本文件内容到项目根目录 .env，或将这些变量合并到已有 .env；
#   3. 只在 MacBook 服务端填写，不要放进浏览器、iPad 地址或 Git；
#   4. 填好后执行：npm run build && npm start；
#   5. 用 curl http://localhost:8787/api/readiness 检查“参数已填写”状态。
#
# 实时链路必须配置：
#   X_API_KEY
#   ARK_API_KEY + ARK_MODEL
# 其余项目都是可选增强能力，留空时使用本地文件和本地规则兜底。

# -----------------------------------------------------------------------------
# A. 豆包大模型流式语音识别（ASR，WebSocket SAUC）
# -----------------------------------------------------------------------------

# 必填。豆包语音新版控制台“API Key 管理”中的 App Key。
# 发送位置：服务端 WebSocket 请求头 X-Api-Key。
# 安全性：高敏感，只保存在 MacBook 服务端 .env。
X_API_KEY=

# 按账号开通的流式语音识别资源 ID。默认值适用于豆包大模型流式语音识别。
# 如果控制台显示其他资源 ID，必须以控制台值为准。
# 发送位置：服务端 WebSocket 请求头 X-Api-Resource-Id。
X_API_RESOURCE_ID=volc.bigasr.sauc.duration

# 豆包大模型流式语音识别 WebSocket 地址。通常保持默认，不要填写 Chat API 地址。
SPEECH_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# 官方 full client request 中 corpus.boosting_table_id / boosting_table_name。
# 每次请求只生效一张热词表，ID 与名称二选一，ID 优先。
BOOSTING_TABLE_ID=
BOOSTING_TABLE_NAME=

# 官方 full client request 中 corpus.correct_table_id / correct_table_name。
# 每次请求只生效一张替换词表，ID 与名称二选一，ID 优先。
CORRECT_TABLE_ID=
CORRECT_TABLE_NAME=

# 官方 full client request 中 request.end_window_size，单位毫秒，最小 200。
END_WINDOW_SIZE=800

# -----------------------------------------------------------------------------
# B. 豆包大模型（火山方舟 Responses API）
# -----------------------------------------------------------------------------

# 必填。火山方舟控制台创建的 API Key。
# 发送位置：HTTPS 请求头 Authorization: Bearer <ARK_API_KEY>。
# 安全性：高敏感，只保存在 MacBook 服务端 .env。
ARK_API_KEY=

# 必填。方舟 Model ID 或已开通 Responses API 的 Endpoint ID。
# 例如 doubao-seed-2-1-pro-260628；不要填写 API Key 名称。
# 不支持 Responses API 的智能路由接入点会返回 AccessDenied。
# 发送位置：Responses 请求体 model 字段。
ARK_MODEL=

# 方舟 Responses 地址。使用官方北京区域地址时保持默认。
# 只有部署了自建代理/网关时才修改为代理地址。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 实时话术合规判断的最大等待时间，单位毫秒。
# 超时后会立即使用本地规则，避免阻塞主播；建议 1500-2500。
ARK_TIMEOUT_MS=2500

# 粘贴商品资料识别的超时时间，单位毫秒；不影响实时收音链路。
ARK_PRODUCT_PARSE_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# C. 火山方舟私域知识库搜索（Responses API，可选）
# -----------------------------------------------------------------------------

# 方舟控制台“知识库资源”标识。
# 发送位置：Responses 请求体 tools[].knowledge_resource_id。
# Responses 请求同时自动发送 ark-beta-knowledge-search: true。
KNOWLEDGE_RESOURCE_ID=

# -----------------------------------------------------------------------------
# D. 停播后原始音频归档（火山 TOS，可选）
# -----------------------------------------------------------------------------

# 注意：这里不是直接填写 TOS Bucket 地址，而是填写你的归档网关 manifest 接口。
# 实时收音期间不上传；停止收音后网关返回预签名 URL，服务端再上传本地音频。
TOS_ARCHIVE_GATEWAY_URL=

# 归档网关鉴权密钥，发送位置：Authorization: Bearer <TOS_ARCHIVE_GATEWAY_KEY>。
TOS_ARCHIVE_GATEWAY_KEY=

# manifest 和音频 PUT 请求超时时间，单位毫秒。
TOS_ARCHIVE_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# E. 火山数据库/Redis 预留（当前版本不会主动连接）
# -----------------------------------------------------------------------------

# 后续 SaaS 阶段使用。当前本地模式仍写入 .data/，填写不会自动迁移数据。
DATABASE_URL=
REDIS_URL=

# -----------------------------------------------------------------------------
# F. 本地数据保存位置（建议保留默认值）
# -----------------------------------------------------------------------------

# 原始音频、16 kHz ASR 副本、时间线 JSONL。
TIMELINE_DATA_DIR=.data/timeline

# 商品库、直播间和本场商品清单。
PRODUCT_CATALOG_PATH=.data/products/catalog.json

# 自定义规则、版本和审计日志。
RULE_CATALOG_PATH=.data/rules/catalog.json

# 按直播间保存的长期语音纠错词库；下一场会自动修正文稿并加入 ASR 上下文。
SPEECH_CORRECTION_CATALOG_PATH=.data/speech-corrections/catalog.json

# 停播归档重试队列。
ARCHIVE_QUEUE_PATH=.data/archive/queue.json

# 本地租户标识，SaaS 接入时必须作为租户隔离字段继续透传。
TENANT_ID=tenant-default
