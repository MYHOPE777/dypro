# dypro 火山引擎接入参数模板
#
# 使用方式：
#   1. 从火山引擎控制台取得对应参数；
#   2. 复制本文件内容到项目根目录 .env，或将这些变量合并到已有 .env；
#   3. 只在 MacBook 服务端填写，不要放进浏览器、iPad 地址或 Git；
#   4. 填好后执行：npm run build && npm start；
#   5. 用 curl http://localhost:8787/api/readiness 检查“参数已填写”状态。
#
# 实时链路必须配置：
#   VOLC_SPEECH_APP_KEY + VOLC_SPEECH_ACCESS_KEY
#   DOUBAO_API_KEY + DOUBAO_ENDPOINT_ID
# 其余项目都是可选增强能力，留空时使用本地文件和本地规则兜底。

# -----------------------------------------------------------------------------
# A. 火山引擎实时语音识别（WebSocket SAUC）
# -----------------------------------------------------------------------------

# 必填。火山引擎控制台“实时语音识别/应用管理”中的 App Key。
# 发送位置：服务端 WebSocket 请求头 X-Api-App-Key。
VOLC_SPEECH_APP_KEY=

# 必填。与 App Key 对应的 Access Key（不是火山账号登录密码）。
# 发送位置：服务端 WebSocket 请求头 X-Api-Access-Key。
# 安全性：高敏感，只保存在 MacBook 服务端 .env。
VOLC_SPEECH_ACCESS_KEY=

# 按账号开通的实时语音资源 ID。默认值适用于大模型短语音流式识别。
# 如果控制台显示其他资源 ID，必须以控制台值为准。
# 发送位置：服务端 WebSocket 请求头 X-Api-Resource-Id。
VOLC_SPEECH_RESOURCE_ID=volc.bigasr.sauc.duration

# 实时语音 WebSocket 地址。通常保持默认，不要填写 Chat API 地址。
VOLC_SPEECH_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel

# -----------------------------------------------------------------------------
# B. 豆包大模型（火山方舟 Chat Completions）
# -----------------------------------------------------------------------------

# 必填。火山方舟控制台创建的 API Key。
# 发送位置：HTTPS 请求头 Authorization: Bearer <DOUBAO_API_KEY>。
# 安全性：高敏感，只保存在 MacBook 服务端 .env。
DOUBAO_API_KEY=

# 必填。火山方舟“推理接入点”的 Endpoint ID，通常形如 ep-xxxxxxxx。
# 这里填 Endpoint ID，不要填模型展示名称、模型 ID 或知识库 ID。
# 发送位置：Chat Completions 请求体 model 字段。
DOUBAO_ENDPOINT_ID=

# 方舟兼容 Chat Completions 地址。使用官方区域地址时保持默认。
# 只有部署了自建代理/网关时才修改为代理地址。
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 实时话术合规判断的最大等待时间，单位毫秒。
# 超时后会立即使用本地规则，避免阻塞主播；建议 1500-2500。
DOUBAO_TIMEOUT_MS=2500

# 粘贴商品资料识别的超时时间，单位毫秒；不影响实时收音链路。
DOUBAO_PRODUCT_PARSE_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# C. 火山方舟知识库（规则/处罚案例召回增强，可选）
# -----------------------------------------------------------------------------

# 这是由你的知识库适配网关暴露的“检索”接口完整 URL。
# 当前项目不猜测方舟控制台内部 URL，必须填写你实际部署的网关地址。
ARK_KB_RETRIEVE_URL=

# 规则发布/停用后同步索引的接口完整 URL，可先留空，之后再接入。
ARK_KB_INDEX_URL=

# 知识库网关 API Key。发送位置：Authorization: Bearer <ARK_KB_API_KEY>。
ARK_KB_API_KEY=

# 方舟知识库的集合/知识空间 ID。由网关转发给方舟，可留空。
ARK_KB_COLLECTION_ID=

# 知识召回/规则索引请求超时时间，单位毫秒；异常会快速降级到本地规则。
ARK_KB_TIMEOUT_MS=1500

# -----------------------------------------------------------------------------
# D. 停播后原始音频归档（火山 TOS，可选）
# -----------------------------------------------------------------------------

# 注意：这里不是直接填写 TOS Bucket 地址，而是填写你的归档网关 manifest 接口。
# 实时收音期间不上传；停止收音后网关返回预签名 URL，服务端再上传本地音频。
TOS_ARCHIVE_GATEWAY_URL=

# 归档网关鉴权密钥，发送位置：Authorization: Bearer <TOS_ARCHIVE_GATEWAY_KEY>。
TOS_ARCHIVE_GATEWAY_KEY=

# manifest 和音频 PUT 请求超时时间，单位毫秒。
TOS_ARCHIVE_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# E. 火山数据库/Redis 预留（当前版本不会主动连接）
# -----------------------------------------------------------------------------

# 后续 SaaS 阶段使用。当前本地模式仍写入 .data/，填写不会自动迁移数据。
DATABASE_URL=
REDIS_URL=

# -----------------------------------------------------------------------------
# F. 本地数据保存位置（建议保留默认值）
# -----------------------------------------------------------------------------

# 原始音频、16 kHz ASR 副本、时间线 JSONL。
TIMELINE_DATA_DIR=.data/timeline

# 商品库、直播间和本场商品清单。
PRODUCT_CATALOG_PATH=.data/products/catalog.json

# 自定义规则、版本和审计日志。
RULE_CATALOG_PATH=.data/rules/catalog.json

# 停播归档重试队列、知识库同步队列。
ARCHIVE_QUEUE_PATH=.data/archive/queue.json
KNOWLEDGE_SYNC_PATH=.data/knowledge/sync.json

# 本地租户标识，SaaS 接入时必须作为租户隔离字段继续透传。
TENANT_ID=tenant-default
