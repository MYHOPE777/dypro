# dypro 环境变量模板
# 复制为 .env 后使用。空值表示关闭对应云能力，并自动使用本地模式或本地兜底。
# 密钥只允许保存在服务端 .env 中，不要写入 src/、提交 Git，或放进主播屏 URL。

# -----------------------------------------------------------------------------
# 1. 本地服务与数据文件
# -----------------------------------------------------------------------------

# Node 服务端口。生产构建、REST API 和 WebSocket 共用此端口。
PORT=8787

# 开发模式下 Vite 前端端口；应与 vite.config.ts 使用的端口一致。
# 生产构建存在 dist/client 时，前端直接使用 PORT，此参数不参与生产服务。
CLIENT_PORT=5173

# v0.3 SQLite/WAL 唯一事实源与双轨音频目录。旧 .data 不会自动迁移。
V2_DB_PATH=.data-v2/app.sqlite
V2_AUDIO_DIR=.data-v2/audio

# 共享规则审核人账号。多人模式下必须对应 AUTH_USERS_JSON 中 role=reviewer 的账号。
RULE_REVIEWER_ACTOR_ID=owner

# -----------------------------------------------------------------------------
# 2. 多人登录与权限
# 本机单人调试时以下 AUTH_TOKEN_SECRET 和 AUTH_USERS_JSON 必须同时留空。
# -----------------------------------------------------------------------------

# 登录令牌 HMAC 密钥，至少 32 个字符。生产环境应使用随机值并由密钥服务注入。
AUTH_TOKEN_SECRET=

# 登录有效期，单位小时，必须为正数，系统按最少 1 小时处理；默认 12。
AUTH_TOKEN_TTL_HOURS=12

# 是否允许多人账号通过明文 HTTP/WS 控制。生产环境必须保持 false 并使用 HTTPS/WSS。
# 仅隔离局域网临时联调时才可设为 true。
ALLOW_INSECURE_AUTH=false

# JSON 账号数组。与 AUTH_TOKEN_SECRET 同时配置才启用多人模式。
# 字段：actorId、displayName、passwordHash、role、roomIds，可选 tenantId/tenantIds。
# 完整格式及密码哈希生成方式见 docs/CONFIGURATION.md。
AUTH_USERS_JSON=

# -----------------------------------------------------------------------------
# 3. 豆包大模型流式语音识别（ASR，新版控制台）
# X_API_KEY 填写后启用，否则使用演示输入。
# -----------------------------------------------------------------------------

# 豆包语音新版控制台的 App Key，通过 WebSocket 请求头 X-Api-Key 发送。
X_API_KEY=

# 旧版控制台兼容项：X_API_KEY 留空时，使用 APP ID + Access Token。
# 对应官方请求头 X-Api-App-Key / X-Api-Access-Key；Secret Key 不直接用于“双向流式模式（优化版本）”WebSocket 接口。
X_API_APP_KEY=
X_API_ACCESS_KEY=

# 已开通的豆包大模型流式语音识别资源 ID，通过请求头 X-Api-Resource-Id 发送。
# 模型 1.0：小时版 volc.bigasr.sauc.duration，并发版 volc.bigasr.sauc.concurrent。
# 模型 2.0：小时版 volc.seedasr.sauc.duration，并发版 volc.seedasr.sauc.concurrent。
X_API_RESOURCE_ID=volc.seedasr.sauc.duration

# 豆包大模型流式语音识别 WebSocket 地址。除非控制台给出不同地址，否则不要修改。
SPEECH_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# 火山自学习平台热词表/替换词表。每类只配置 ID 或名称其中一个，ID 优先。
BOOSTING_TABLE_ID=
BOOSTING_TABLE_NAME=
CORRECT_TABLE_ID=
CORRECT_TABLE_NAME=

# 二遍识别 VAD 强制判停时间（官方请求参数 end_window_size），单位毫秒，最小 200。
END_WINDOW_SIZE=800

# -----------------------------------------------------------------------------
# 4. 火山方舟 Responses API（豆包大模型）
# ARK_API_KEY 与 ARK_MODEL 同时填写后启用；密钥只在 Node 服务端使用。
# -----------------------------------------------------------------------------

# 火山方舟 API Key，通过 Authorization: Bearer <key> 发送。
ARK_API_KEY=

# 方舟 Model ID 或已开通 Responses API 的 Endpoint ID，作为请求体的 model 字段。
# 例如：doubao-seed-2-1-pro-260628。不要填写 API Key 名称；不支持 Responses API 的智能路由接入点会返回 AccessDenied。
ARK_MODEL=

# 火山方舟 Responses API 接口地址。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 官方 Responses API service_tier：auto=在线推理（常规），fast=在线推理（低延迟）。
# fast 需要控制台为当前模型开通低延迟服务；当前 Pro 模型请先保持 auto。
ARK_SERVICE_TIER=auto

# 直播话术合规判定超时，单位毫秒。超时后立即使用本地规则，默认 5000；低延迟推理接入点可调低。
ARK_TIMEOUT_MS=5000

# 合规 JSON 最大输出 token，范围 160-800；输出越短通常响应越快，默认 200。
ARK_COMPLIANCE_MAX_OUTPUT_TOKENS=200

# 本地高置信 warning 直接预警，不等待方舟；false 用于模型结果对比。
ARK_LOCAL_FAST_PATH=true

# 相同话术短时缓存，单位毫秒；默认 30000，设为 0 关闭。
ARK_COMPLIANCE_CACHE_TTL_MS=30000

# 直播教练建议：每句最终转录后异步生成主播下一句话术；未配置时使用本地安全建议。
ARK_COACH_TIMEOUT_MS=3500
ARK_COACH_MAX_OUTPUT_TOKENS=520

# -----------------------------------------------------------------------------
# 5. 火山方舟私域知识库搜索（Responses API，可选）
# 知识库是召回增强层，不代替商品库、规则库或业务数据库。
# 规则事实仍保存在本地/业务数据库；Responses API 通过官方 knowledge_search 工具读取知识库。
# -----------------------------------------------------------------------------

# 方舟控制台“知识库资源”标识，对应 Responses API tools[].knowledge_resource_id。
# 仅旗舰版知识库支持该官方工具；留空时不发送 knowledge_search。
KNOWLEDGE_RESOURCE_ID=

# v0.3 不连接真实云数据库/知识库上传 adapter。人工确认后任务保留在 SQLite queued 状态。
