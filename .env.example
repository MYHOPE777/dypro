# dypro 环境变量模板
# 复制为 .env 后使用。空值表示关闭对应云能力，并自动使用本地模式或本地兜底。
# 密钥只允许保存在服务端 .env 中，不要写入 src/、提交 Git，或放进主播屏 URL。

# -----------------------------------------------------------------------------
# 1. 本地服务与数据文件
# -----------------------------------------------------------------------------

# Node 服务端口。生产构建、REST API 和 WebSocket 共用此端口。
PORT=8787

# 开发模式下 Vite 前端端口；应与 vite.config.ts 使用的端口一致。
# 生产构建存在 dist/client 时，前端直接使用 PORT，此参数不参与生产服务。
CLIENT_PORT=5173

# 时间线和音频根目录。每场直播会创建 <sessionId>/ 子目录。
# 保存 timeline.jsonl、16k ASR PCM、浏览器原始采样率 PCM 和音轨元数据。
TIMELINE_DATA_DIR=.data/timeline

# 长期商品库、本场商品清单和直播间资料的本地 JSON 文件。
PRODUCT_CATALOG_PATH=.data/products/catalog.json

# 规则、版本、启停状态、审核状态及审计日志的本地 JSON 文件。
RULE_CATALOG_PATH=.data/rules/catalog.json

# 主播档案、归档话术、参考状态和版本历史的本地 JSON 文件。
PHRASE_LIBRARY_PATH=.data/phrases/catalog.json

# 两类后台同步任务的本地队列。云端不可用时保留并自动重试。
RULE_SYNC_QUEUE_PATH=.data/rules/sync-queue.json
PHRASE_LIBRARY_SYNC_QUEUE_PATH=.data/phrases/sync-queue.json

# 直播间长期语音纠错词库。停播复核保存的“错误词 → 正确词”记录写入此文件。
SPEECH_CORRECTION_CATALOG_PATH=.data/speech-corrections/catalog.json

# 本地阶段的默认租户标识。未来接入 SaaS 数据库后用于租户隔离。
TENANT_ID=tenant-default

# 共享规则审核人账号。多人模式下必须对应 AUTH_USERS_JSON 中 role=reviewer 的账号。
RULE_REVIEWER_ACTOR_ID=owner

# 豆包明确判定为词级规则时，自动生成待审核候选的最低置信度，范围 0.8-1，默认 0.93。
RULE_LEARNING_MIN_CONFIDENCE=0.93

# 最后一个页面断开后，会话保留时长，单位毫秒；最小 60000，默认 30 分钟。
SESSION_IDLE_TTL_MS=1800000

# 停止收音后的 TOS 归档任务队列文件。失败任务保留并自动重试。
ARCHIVE_QUEUE_PATH=.data/archive/queue.json

# -----------------------------------------------------------------------------
# 2. 多人登录与权限
# 本机单人调试时以下 AUTH_TOKEN_SECRET 和 AUTH_USERS_JSON 必须同时留空。
# -----------------------------------------------------------------------------

# 登录令牌 HMAC 密钥，至少 32 个字符。生产环境应使用随机值并由密钥服务注入。
AUTH_TOKEN_SECRET=

# 登录有效期，单位小时，必须为正数，系统按最少 1 小时处理；默认 12。
AUTH_TOKEN_TTL_HOURS=12

# 是否允许多人账号通过明文 HTTP/WS 控制。生产环境必须保持 false 并使用 HTTPS/WSS。
# 仅隔离局域网临时联调时才可设为 true。
ALLOW_INSECURE_AUTH=false

# JSON 账号数组。与 AUTH_TOKEN_SECRET 同时配置才启用多人模式。
# 字段：actorId、displayName、passwordHash、role、roomIds，可选 tenantId/tenantIds。
# 完整格式及密码哈希生成方式见 docs/CONFIGURATION.md。
AUTH_USERS_JSON=

# -----------------------------------------------------------------------------
# 3. 豆包大模型流式语音识别（ASR，新版控制台）
# X_API_KEY 填写后启用，否则使用演示输入。
# -----------------------------------------------------------------------------

# 豆包语音新版控制台的 App Key，通过 WebSocket 请求头 X-Api-Key 发送。
X_API_KEY=

# 旧版控制台兼容项：X_API_KEY 留空时，使用 APP ID + Access Token。
# 对应官方请求头 X-Api-App-Key / X-Api-Access-Key；Secret Key 不直接用于 SAUC WebSocket。
X_API_APP_KEY=
X_API_ACCESS_KEY=

# 已开通的流式语音识别资源 ID，通过请求头 X-Api-Resource-Id 发送；并发版为 volc.bigasr.sauc.concurrent，小时版为 volc.bigasr.sauc.duration。
X_API_RESOURCE_ID=volc.bigasr.sauc.duration

# 豆包大模型流式语音识别 WebSocket 地址。除非控制台给出不同地址，否则不要修改。
SPEECH_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# 火山自学习平台热词表/替换词表。每类只配置 ID 或名称其中一个，ID 优先。
BOOSTING_TABLE_ID=
BOOSTING_TABLE_NAME=
CORRECT_TABLE_ID=
CORRECT_TABLE_NAME=

# 二遍识别 VAD 强制判停时间（官方请求参数 end_window_size），单位毫秒，最小 200。
END_WINDOW_SIZE=800

# -----------------------------------------------------------------------------
# 4. 豆包大模型 / 火山方舟 Responses API
# ARK_API_KEY 与 ARK_MODEL 同时填写后启用；密钥只在 Node 服务端使用。
# -----------------------------------------------------------------------------

# 火山方舟 API Key，通过 Authorization: Bearer <key> 发送。
ARK_API_KEY=

# 方舟 Model ID 或已开通 Responses API 的 Endpoint ID，作为请求体的 model 字段。
# 例如：doubao-seed-2-1-pro-260628。不要填写 API Key 名称；不支持 Responses API 的智能路由接入点会返回 AccessDenied。
ARK_MODEL=

# 方舟 Responses 接口地址。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 官方 Responses API service_tier：auto=在线推理（常规），fast=在线推理（低延迟）。
# fast 需要控制台为当前模型开通低延迟服务；当前 Pro 模型请先保持 auto。
ARK_SERVICE_TIER=auto

# 实时话术合规判定超时，单位毫秒。超时后立即使用本地规则，默认 5000；低延迟推理接入点可调低。
ARK_TIMEOUT_MS=5000

# 合规 JSON 最大输出 token，范围 160-800；输出越短通常响应越快，默认 200。
ARK_COMPLIANCE_MAX_OUTPUT_TOKENS=200

# 本地高置信 warning 直接预警，不等待方舟；false 用于模型结果对比。
ARK_LOCAL_FAST_PATH=true

# 相同话术短时缓存，单位毫秒；默认 30000，设为 0 关闭。
ARK_COMPLIANCE_CACHE_TTL_MS=30000

# 直播教练建议：每句最终转录后异步生成主播下一句话术；未配置时使用本地安全建议。
ARK_COACH_TIMEOUT_MS=3500
ARK_COACH_MAX_OUTPUT_TOKENS=520

# 主播话术单条豆包改写的超时，单位毫秒。
ARK_PHRASE_REWRITE_TIMEOUT_MS=4000

# 粘贴商品资料结构化超时，单位毫秒。该操作不在实时链路，默认 10000。
ARK_PRODUCT_PARSE_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# 5. 火山方舟私域知识库搜索（Responses API，可选）
# 知识库是召回增强层，不代替商品库、规则库或业务数据库。
# 规则事实仍保存在本地/业务数据库；Responses API 通过官方 knowledge_search 工具读取知识库。
# -----------------------------------------------------------------------------

# 方舟控制台“知识库资源”标识，对应 Responses API tools[].knowledge_resource_id。
# 仅旗舰版知识库支持该官方工具；留空时不发送 knowledge_search。
KNOWLEDGE_RESOURCE_ID=

# -----------------------------------------------------------------------------
# 6. 规则与主播话术异步同步网关（可选）
# URL 与 KEY 同时填写后启用。直播只写本地队列，后台失败不会阻塞实时预警与题词。
# 网关再负责写入火山数据库或知识库，并按 rule/phrase id + version 保证幂等。
# -----------------------------------------------------------------------------

RULE_SYNC_URL=
RULE_SYNC_KEY=
RULE_SYNC_TIMEOUT_MS=5000

PHRASE_LIBRARY_SYNC_URL=
PHRASE_LIBRARY_SYNC_KEY=
PHRASE_LIBRARY_SYNC_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# 7. 业务数据库与 Redis（SaaS 预留）
# 当前版本只在开播检查中显示配置状态，尚未建立真实数据库/Redis 连接。
# 本地阶段请留空，商品、规则和会话继续写入 .data/。
# -----------------------------------------------------------------------------

DATABASE_URL=
REDIS_URL=

# -----------------------------------------------------------------------------
# 8. 停播后 TOS 音频归档网关
# URL 与 KEY 同时填写后启用。实时收音时不会上传；重新收音会暂停在途上传。
# -----------------------------------------------------------------------------

# 自建归档网关的 manifest 接口完整 URL，不是 TOS Bucket 控制台地址。
TOS_ARCHIVE_GATEWAY_URL=

# 归档网关鉴权密钥，通过 Authorization: Bearer <key> 发送。
TOS_ARCHIVE_GATEWAY_KEY=

# manifest 请求及每个音频文件 PUT 的超时，单位毫秒，默认 10000。
TOS_ARCHIVE_TIMEOUT_MS=10000
