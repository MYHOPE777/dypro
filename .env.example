# Server
PORT=8787
CLIENT_PORT=5173
TIMELINE_DATA_DIR=.data/timeline
PRODUCT_CATALOG_PATH=.data/products/catalog.json
RULE_CATALOG_PATH=.data/rules/catalog.json
TENANT_ID=tenant-default
RULE_REVIEWER_ACTOR_ID=owner
SESSION_IDLE_TTL_MS=1800000
ARCHIVE_QUEUE_PATH=.data/archive/queue.json

# Multi-user control access. Operators only access assigned roomIds or rooms they create.
# Leave AUTH_TOKEN_SECRET and AUTH_USERS_JSON blank for localhost-only control.
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_HOURS=12
ALLOW_INSECURE_AUTH=false
AUTH_USERS_JSON=[{"actorId":"owner","displayName":"系统审核人","passwordHash":"scrypt$replace_owner_salt$replace_owner_hash","role":"reviewer","roomIds":[]},{"actorId":"operator-01","displayName":"一号场控","passwordHash":"scrypt$replace_operator_salt$replace_operator_hash","role":"operator","roomIds":["room-default"]}]

# Volcengine realtime speech (server-side only)
VOLC_SPEECH_APP_KEY=
VOLC_SPEECH_ACCESS_KEY=
VOLC_SPEECH_RESOURCE_ID=volc.bigasr.sauc.duration
VOLC_SPEECH_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel

# Volcengine Doubao / Ark Chat Completions (server-side only)
DOUBAO_API_KEY=
DOUBAO_ENDPOINT_ID=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_TIMEOUT_MS=2500
DOUBAO_PRODUCT_PARSE_TIMEOUT_MS=10000

# Ark knowledge-base retrieval/index gateway. Leave blank for local-only mode.
# Use the endpoint contract supplied by your Ark console or your controlled gateway;
# the app intentionally does not guess an undocumented Ark URL.
ARK_KB_RETRIEVE_URL=
ARK_KB_INDEX_URL=
ARK_KB_API_KEY=
ARK_KB_COLLECTION_ID=
ARK_KB_TIMEOUT_MS=1500

# Business persistence and cross-process coordination (reserved for SaaS deployment).
DATABASE_URL=
REDIS_URL=

# TOS archive gateway. It is called only after capture stops, never per audio chunk.
# The gateway writes to Volcengine TOS and returns {"uploadUrls":{"asr":"..."}}.
TOS_ARCHIVE_GATEWAY_URL=
TOS_ARCHIVE_GATEWAY_KEY=
TOS_ARCHIVE_TIMEOUT_MS=10000
